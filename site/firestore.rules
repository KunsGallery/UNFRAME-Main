rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function staff() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com'
    && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
    && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
    && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.email == request.auth.token.email;
  }
  function validImage(image) {
   return image is map && image.keys().hasAll(['url','path','alt'])
    && image.url is string && image.path is string && image.alt is string
    && image.alt.size() <= 1000;
  }
  function valid(data,id) {
   return data.keys().hasAll(['title','slug','startDate','endDate','location','artists','summary','description','hours','admission','address','mapUrl','bookingUrl','cover','gallery','published','order','updatedAt','imagePaths'])
    && data.keys().hasOnly(['title','slug','startDate','endDate','location','artists','summary','description','hours','admission','address','mapUrl','bookingUrl','cover','gallery','published','order','updatedAt','imagePaths'])
    && data.title is string && data.title.size()>0 && data.title.size()<=200
    && data.slug is string && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && data.slug.size()<=200
    && data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && data.endDate is string && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.endDate >= data.startDate
    && data.location is string && data.location.size()>0 && data.location.size()<=1000
    && data.artists is string && data.artists.size()<=3000
    && data.summary is string && data.summary.size()<=600
    && data.description is string && data.description.size()<=30000
    && data.hours is string && data.hours.size()<=1000
    && data.admission is string && data.admission.size()<=1000
    && data.address is string && data.address.size()<=1000
    && data.mapUrl is string && data.mapUrl.size()<=2000
    && data.bookingUrl is string && data.bookingUrl.size()<=2000
    && validImage(data.cover) && data.gallery is list && data.gallery.size()<=30
    && data.published is bool && data.order is int && data.order>=0
    && data.imagePaths is list && data.imagePaths.size()<=31
    && data.updatedAt is string && data.updatedAt.size()<=50
    && (!data.published || (data.description.size()>0 && data.cover.path.matches('^exhibitions/'+id+'/[^/]+$')));
  }
  match /staff/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, create, update, delete: if false;
  }
  match /exhibitions/{id} {
   allow read: if resource.data.published == true || staff();
   allow create, update: if staff() && valid(request.resource.data,id);
   allow delete: if staff();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
