// Prototype model: exhibitions contain public editorial content when published=true.
// staff/{uid}: email + active, readable only by that user, managed outside client apps.
// All exhibition writes require verified Google sign-in plus a matching active staff record.
// staffEmails/{email}: email + active, managed by trusted project administrators.
// Image paths are scoped to the exhibition; uploads are handled by the R2 Worker.
// Gallery writes use [path, alt, caption] strings joined by US (U+001F).
// Dual RS/GS joins validate every entry within the Firestore expression budget.
// Legacy image maps remain readable and supported for smaller existing forms.
// homeHighlights/{id}: public published event/virtual/news cards; staff manage drafts.
// Optional nowFeatured selects UNFRAME NOW independently of hero featured.
// Required bounded fields: kind, title, summary, project, url, dates, cover,
// published, featured, order and updatedAt. Cover URLs stay empty; R2 paths use the card ID.
// virtualGalleries/{exid}: exhibition-linked display settings; artworks/{artid}
// contain bounded labels, dimensions, placement and a scoped R2 image reference.
// Public viewing requires both the exhibition and virtual gallery to be published.
// Artist galleries add exhibitionId + artistName + order together. Their parent
// is immutable; legacy galleries omit all three and use their own ID as parent.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function staff() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com'
    && exists(/databases/$(database)/documents/staffEmails/$(request.auth.token.email))
    && get(/databases/$(database)/documents/staffEmails/$(request.auth.token.email)).data.active == true
    && get(/databases/$(database)/documents/staffEmails/$(request.auth.token.email)).data.email == request.auth.token.email;
  }
  function validImage(image,pattern) {
   // Required field access and matches() reject absent or wrongly typed fields.
   let caption = image.get('caption','');
   return image.keys().hasOnly(['url','path','alt','caption'])
    && image.url == '' && image.path.matches(pattern)
    && image.alt.matches('^[\\s\\S]{0,1000}$')
    && caption.matches('^[\\s\\S]{0,1000}[\\s\\S]{0,1000}$');
  }
  // Short lazy chains avoid validating absent legacy entries.
  function galleryGroup0(items,count,pattern) {
   return (count<=0 ? true : (validImage(items[0],pattern) &&
    (count<=1 ? true : (validImage(items[1],pattern) &&
    (count<=2 ? true : (validImage(items[2],pattern) &&
    (count<=3 ? true : (validImage(items[3],pattern) &&
    (count<=4 ? true : (validImage(items[4],pattern) &&
    galleryGroup5(items,count,pattern)))))))))));
  }
  function galleryGroup5(items,count,pattern) {
   return (count<=5 ? true : (validImage(items[5],pattern) &&
    (count<=6 ? true : (validImage(items[6],pattern) &&
    (count<=7 ? true : (validImage(items[7],pattern) &&
    (count<=8 ? true : (validImage(items[8],pattern) &&
    (count<=9 ? true : (validImage(items[9],pattern) &&
    galleryGroup10(items,count,pattern)))))))))));
  }
  function galleryGroup10(items,count,pattern) {
   return (count<=10 ? true : (validImage(items[10],pattern) &&
    (count<=11 ? true : (validImage(items[11],pattern) &&
    (count<=12 ? true : (validImage(items[12],pattern) &&
    (count<=13 ? true : (validImage(items[13],pattern) &&
    (count<=14 ? true : (validImage(items[14],pattern) &&
    galleryGroup15(items,count,pattern)))))))))));
  }
  function galleryGroup15(items,count,pattern) {
   return (count<=15 ? true : (validImage(items[15],pattern) &&
    (count<=16 ? true : (validImage(items[16],pattern) &&
    (count<=17 ? true : (validImage(items[17],pattern) &&
    (count<=18 ? true : (validImage(items[18],pattern) &&
    (count<=19 ? true : (validImage(items[19],pattern) &&
    galleryGroup20(items,count,pattern)))))))))));
  }
  function galleryGroup20(items,count,pattern) {
   return (count<=20 ? true : (validImage(items[20],pattern) &&
    (count<=21 ? true : (validImage(items[21],pattern) &&
    (count<=22 ? true : (validImage(items[22],pattern) &&
    (count<=23 ? true : (validImage(items[23],pattern) &&
    (count<=24 ? true : (validImage(items[24],pattern) &&
    galleryGroup25(items,count,pattern)))))))))));
  }
  function galleryGroup25(items,count,pattern) {
   return (count<=25 ? true : (validImage(items[25],pattern) &&
    (count<=26 ? true : (validImage(items[26],pattern) &&
    (count<=27 ? true : (validImage(items[27],pattern) &&
    (count<=28 ? true : (validImage(items[28],pattern) &&
    (count<=29 ? true : (validImage(items[29],pattern) &&
    true))))))))));
  }
  function validLegacyGallery(items,id) { return galleryGroup0(items,items.size(),'^$|^exhibitions/'+id+'/[^/]{1,400}$'); }
  function validGallery(items,id) {
   let image = 'exhibitions/'+id+'/[^/\u001f\u001e\u001d]{1,400}\u001f[^\u001f\u001e\u001d]{0,1000}\u001f[^\u001f\u001e\u001d]{0,1000}[^\u001f\u001e\u001d]{0,1000}';
   return items is list && items.size()<=30 && (items.size()==0 ? true :
    (items[0] is string ?
     (items.join('\u001e').matches('^'+image+'(\u001e'+image+')*$')
      && items.join('\u001d').matches('^'+image+'(\u001d'+image+')*$'))
     : validLegacyGallery(items,id)));
  }
  function validPaths(items,id) {
   let prefix = 'exhibitions/'+id+'/';
   // Both separators must agree, so embedded separators cannot disguise an oversized entry.
   return items is list && items.size()<=31
    && items.join('|').matches('^$|^'+prefix+'[^/|~]{1,400}(\\|'+prefix+'[^/|~]{1,400})*$')
    && items.join('~').matches('^$|^'+prefix+'[^/|~]{1,400}(~'+prefix+'[^/|~]{1,400})*$');
  }
  function valid(data,id) {
   return id.size()<=100 && id.matches('^[A-Za-z0-9_-]+$')
    && data.keys().hasAll(['title','slug','startDate','endDate','location','artists','summary','description','hours','admission','address','mapUrl','bookingUrl','cover','gallery','published','order','updatedAt','imagePaths'])
    && data.keys().hasOnly(['title','slug','startDate','endDate','location','artists','summary','description','hours','admission','address','mapUrl','bookingUrl','cover','gallery','published','order','updatedAt','imagePaths','viewingRoomEnabled'])
    && data.title is string && data.title.size()>0 && data.title.size()<=200
    && data.slug is string && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && data.slug.size()<=200
    && data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && data.endDate is string && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.endDate >= data.startDate
    && data.location is string && data.location.size()>0 && data.location.size()<=1000
    && data.artists is string && data.artists.size()<=3000
    && data.summary is string && data.summary.size()<=600
    && data.description is string && data.description.size()<=30000
    && data.hours is string && data.hours.size()<=1000
    && data.admission is string && data.admission.size()<=1000
    && data.address is string && data.address.size()<=1000
    && data.mapUrl is string && data.mapUrl.size()<=2000
    && data.bookingUrl is string && data.bookingUrl.size()<=2000
    && validImage(data.cover,'^$|^exhibitions/'+id+'/[^/]{1,400}$') && validGallery(data.gallery,id)
    && (!('viewingRoomEnabled' in data) || data.viewingRoomEnabled is bool)
    && data.published is bool && data.order is int && data.order>=0 && data.order<=1000000
    && validPaths(data.imagePaths,id)
    && data.updatedAt is string && data.updatedAt.size()<=50
    && (!data.published || (data.description.size()>0 && data.cover.path.matches('^exhibitions/'+id+'/[^/]+$')));
  }
  function validHighlightCover(cover,id) {
   return cover is map && cover.keys().hasAll(['url','path','alt'])
    && cover.keys().hasOnly(['url','path','alt'])
    && cover.url == '' && cover.path is string && cover.path.size()<=512
    && (cover.path == '' || cover.path.matches('^homeHighlights/'+id+'/[^/]+$'))
    && cover.alt is string && cover.alt.size()<=1000;
  }
  function validHighlightDate(value) {
   return value is string && value.size()<=10
    && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
  }
  function validHighlight(data,id) {
   return id.size()<=128 && id.matches('^[A-Za-z0-9_-]+$')
    && data.keys().hasAll(['kind','title','summary','project','url','startDate','endDate','cover','published','featured','order','updatedAt'])
    && data.keys().hasOnly(['kind','title','summary','project','url','startDate','endDate','cover','published','featured','nowFeatured','order','updatedAt'])
    && data.kind in ['event','virtual','news']
    && data.title is string && data.title.size()>0 && data.title.size()<=200
    && data.summary is string && data.summary.size()<=600
    && data.project is string && data.project.size()<=100
    && data.url is string && data.url.size()<=2000
    && (data.url == '' || data.url.matches('^https?://[^/ ].*$') || data.url.matches('^/([^/].*)?$'))
    && validHighlightDate(data.startDate) && validHighlightDate(data.endDate)
    && (data.kind == 'event' || ((data.startDate == '' && data.endDate == '')
     || (data.startDate != '' && data.endDate != '' && data.endDate >= data.startDate)))
    && validHighlightCover(data.cover,id)
    && data.published is bool && data.featured is bool
    && (!('nowFeatured' in data) || data.nowFeatured is bool)
    && (data.kind != 'virtual' || data.get('nowFeatured',false) == false)
    && data.order is int && data.order>=0 && data.order<=1000000
    && data.updatedAt is string && data.updatedAt.size()<=100
    && (!data.published || (data.url.size()>0 && data.cover.path.size()>0
     && (data.kind != 'event' || (data.startDate != '' && data.endDate != '' && data.endDate >= data.startDate))
     && ((data.kind != 'news' && data.get('nowFeatured',false) == false) || data.project in ['UP','음','U#','U.A.U','UNFRAME SALON'])));
  }
  function virtualId(id) {
   return id.size()<=100 && id.matches('^[A-Za-z0-9_-]+$');
  }
  function virtualParent(data,galleryId) {
   return 'exhibitionId' in data ? data.exhibitionId : galleryId;
  }
  function virtualParentExists(data,galleryId) {
   return exists(/databases/$(database)/documents/exhibitions/$(virtualParent(data,galleryId)));
  }
  function publicVirtualSettings(data,galleryId) {
   return data.published == true && virtualParentExists(data,galleryId)
    && get(/databases/$(database)/documents/exhibitions/$(virtualParent(data,galleryId))).data.published == true;
  }
  function publicVirtualGallery(galleryId) {
   return exists(/databases/$(database)/documents/virtualGalleries/$(galleryId))
    && publicVirtualSettings(get(/databases/$(database)/documents/virtualGalleries/$(galleryId)).data,galleryId);
  }
  function validVirtualAssociation(data,galleryId) {
   return 'exhibitionId' in data ?
    (data.keys().hasAll(['exhibitionId','artistName','order'])
     && data.exhibitionId is string && virtualId(data.exhibitionId) && data.exhibitionId != galleryId
     && data.artistName is string && data.artistName.size()>0 && data.artistName.size()<=300
     && data.order is int && data.order>=0 && data.order<=1000000)
    : !data.keys().hasAny(['artistName','order']);
  }
  function validVirtualGallery(data,exid) {
   return virtualId(exid)
    && data.keys().hasAll(['title','subtitle','published','theme','wallColor','brightness','speed','outdoor','showPrices','updatedAt'])
    && data.keys().hasOnly(['title','subtitle','published','theme','wallColor','brightness','speed','outdoor','showPrices','updatedAt','exhibitionId','artistName','order','lighting','ceiling','artistEmail','artistNote','roomSize'])
    && validVirtualAssociation(data,exid)
    && data.title is string && data.title.size()>0 && data.title.size()<=200
    && data.subtitle is string && data.subtitle.size()<=1000
    && data.published is bool && data.theme in ['white','black','herringbone-wood','wood','urethane']
    && (!('lighting' in data) || data.lighting in ['general','focused'])
    && (!('ceiling' in data) || data.ceiling in ['plain','luminous'])
    && (!('artistEmail' in data) || (data.artistEmail is string && data.artistEmail.size()>0 && data.artistEmail.size()<=320))
    && (!('artistNote' in data) || (data.artistNote is string && data.artistNote.size()<=600))
    && (!('roomSize' in data) || data.roomSize in ['small','medium','large'])
    && data.wallColor is string && data.wallColor.matches('^#[0-9a-fA-F]{6}$')
    && data.brightness is number && data.brightness>=0.5 && data.brightness<=1.8
    && data.speed is number && data.speed>=1 && data.speed<=5
    && data.outdoor is bool && data.showPrices is bool
    && data.updatedAt is string && data.updatedAt.size()<=50
    && data.updatedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$');
  }
  function validArtworkImage(image,exid,artid) {
   return image is map && image.keys().hasAll(['url','path','alt'])
    && image.keys().hasOnly(['url','path','alt']) && image.url == ''
    && image.path is string && image.path.size()<=512
    && image.path.matches('^virtualGalleries/'+exid+'/'+artid+'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}[.](png|jpeg|webp)$')
    && image.alt is string && image.alt.size()<=1000;
  }
  function validArtwork(data,exid,artid) {
   return virtualId(exid) && virtualId(artid) && validArtworkFields(data)
    && validArtworkImage(data.image,exid,artid)
    && (!('model' in data) || validModel(data.model,'virtualGalleries/'+exid+'/'+artid+'/'));
  }
  // 3D objects: one uncompressed GLB stored beside the artwork's images.
  function validModel(model,prefix) {
   return model is map && model.keys().hasAll(['path','name']) && model.keys().hasOnly(['path','name'])
    && model.name is string && model.name.size()<=200
    && model.path is string && model.path.size()<=512
    && model.path.matches('^'+prefix+'[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}[.]glb$');
  }
  function validArtworkFields(data) {
   return data.keys().hasAll(['title','titleEn','artist','year','medium','widthCm','heightCm','price','description','wall','frame','order','image','updatedAt'])
    && data.keys().hasOnly(['title','titleEn','artist','year','medium','widthCm','heightCm','price','description','wall','frame','order','image','updatedAt','canvasThickness','canvasEdge','shape','saleStatus','kind','depthCm','spot','yaw','plinth','copies','model'])
    && data.title is string && data.title.size()>0 && data.title.size()<=200
    && data.titleEn is string && data.titleEn.size()<=200
    && data.artist is string && data.artist.size()>0 && data.artist.size()<=300
    && data.year is string && data.year.size()<=20
    && data.medium is string && data.medium.size()<=500
    && data.widthCm is number && data.widthCm>=10 && data.widthCm<=500
    && data.heightCm is number && data.heightCm>=10 && data.heightCm<=500
    && data.price is string && data.price.size()<=100
    && data.description is string && data.description.size()<=5000
    && data.wall in ['front','right','left'] && data.frame in ['black','wood','white','none','canvas']
    && data.order is int && data.order>=0 && data.order<=1000000
    && (!('canvasThickness' in data) || (data.canvasThickness is number && data.canvasThickness>=0.5 && data.canvasThickness<=10))
    && (!('canvasEdge' in data) || data.canvasEdge in ['natural','black','image'])
    && (!('shape' in data) || data.shape in ['rect','circle','free'])
    && (!('saleStatus' in data) || data.saleStatus in ['available','reserved','sold','nfs'])
    && (!('kind' in data) || data.kind in ['flat','object'])
    && (!('depthCm' in data) || (data.depthCm is number && data.depthCm>=10 && data.depthCm<=500))
    && (!('spot' in data) || (data.spot is string && data.spot.matches('^[a-z-]{1,40}$')))
    && (!('yaw' in data) || (data.yaw is int && data.yaw>=0 && data.yaw<=359))
    && (!('plinth' in data) || data.plinth in ['none','low','high'])
    && (!('copies' in data) || (data.copies is int && data.copies>=1 && data.copies<=5))
    && data.updatedAt is string && data.updatedAt.size()<=50
    && data.updatedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$');
  }
  match /virtualGalleries/{exid} {
   allow read: if publicVirtualSettings(resource.data,exid) || staff() || boundArtist(resource.data);
   allow create: if staff()
    && virtualParentExists(request.resource.data,exid)
    && validVirtualGallery(request.resource.data,exid);
   allow update: if staff()
    && virtualParentExists(request.resource.data,exid)
    && virtualParent(request.resource.data,exid) == virtualParent(resource.data,exid)
    && ('exhibitionId' in request.resource.data) == ('exhibitionId' in resource.data)
    && validVirtualGallery(request.resource.data,exid);
   allow delete: if staff();
   match /artworks/{artid} {
    allow read: if publicVirtualGallery(exid) || staff()
     || boundArtist(get(/databases/$(database)/documents/virtualGalleries/$(exid)).data);
    allow create, update: if staff()
     && exists(/databases/$(database)/documents/virtualGalleries/$(exid))
     && virtualParentExists(get(/databases/$(database)/documents/virtualGalleries/$(exid)).data,exid)
     && validArtwork(request.resource.data,exid,artid);
    allow delete: if staff();
   }
  }
  // virtualSubmissions/{id}: invited artist uploads. Never public; bound to the first
  // Google account that claims the link; unusable ten days after the last server touch.
  function googleUser() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function boundArtist(data) {
   return googleUser() && data.get('artistEmail','') == request.auth.token.email;
  }
  function submissionLive(data) { return data.touchedAt + duration.value(10,'d') > request.time; }
  function submissionOwner(data) { return googleUser() && data.ownerEmail == request.auth.token.email; }
  function submissionPath(sid) { return /databases/$(database)/documents/virtualSubmissions/$(sid); }
  function validSubmissionSettings(s) {
   return s is map && s.keys().hasAll(['theme','wallColor','lighting','ceiling']) && s.keys().hasOnly(['theme','wallColor','lighting','ceiling','artistNote','roomSize'])
    && (!('roomSize' in s) || s.roomSize in ['small','medium','large'])
    && (!('artistNote' in s) || (s.artistNote is string && s.artistNote.size()<=600))
    && s.theme in ['white','black','herringbone-wood','wood','urethane']
    && s.wallColor is string && s.wallColor.matches('^#[0-9a-fA-F]{6}$')
    && s.lighting in ['general','focused'] && s.ceiling in ['plain','luminous'];
  }
  function validSubmission(data,sid) {
   return sid.matches('^[A-Za-z0-9]{22}$')
    && data.keys().hasAll(['exhibitionId','exhibitionTitle','artistName','invitedEmail','ownerEmail','targetGalleryId','status','reviewNote','settings','approvedGalleryId','createdAt','touchedAt'])
    && data.keys().hasOnly(['exhibitionId','exhibitionTitle','artistName','invitedEmail','ownerEmail','targetGalleryId','status','reviewNote','settings','approvedGalleryId','createdAt','touchedAt'])
    && data.exhibitionId is string && virtualId(data.exhibitionId)
    && data.exhibitionTitle is string && data.exhibitionTitle.size()<=200
    && data.artistName is string && data.artistName.size()>0 && data.artistName.size()<=300
    && data.invitedEmail is string && data.invitedEmail.size()<=320 && data.invitedEmail == data.invitedEmail.lower()
    && data.ownerEmail is string && data.ownerEmail.size()<=320
    && data.targetGalleryId is string && (data.targetGalleryId == '' || virtualId(data.targetGalleryId))
    && data.approvedGalleryId is string && (data.approvedGalleryId == '' || virtualId(data.approvedGalleryId))
    && data.status in ['invited','draft','submitted','rejected']
    && data.reviewNote is string && data.reviewNote.size()<=1000
    && validSubmissionSettings(data.settings)
    && data.createdAt is timestamp && data.touchedAt == request.time;
  }
  function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
  function artistTransition(before,after) {
   return (before.status in ['draft','rejected'] && after.status in [before.status,'submitted'])
    || (before.status == 'submitted' && after.status == 'draft' && after.settings == before.settings);
  }
  function validSubmissionImage(image,sid,artid,target) {
   return image is map && image.keys().hasAll(['url','path','alt']) && image.keys().hasOnly(['url','path','alt'])
    && image.url == '' && image.path is string && image.path.size()<=512
    && (image.path.matches('^virtualSubmissions/'+sid+'/'+artid+'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}[.](png|jpeg|webp)$')
     || (target != '' && image.path.matches('^virtualGalleries/'+target+'/'+artid+'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}[.](png|jpeg|webp)$')))
    && image.alt is string && image.alt.size()<=1000;
  }
  // Artwork writes must touch the parent in the same batch; the parent's own rule then
  // proves ownership, liveness and an editable status for that touch.
  function artistArtworkWrite(sid) {
   return googleUser() && existsAfter(submissionPath(sid))
    && getAfter(submissionPath(sid)).data.touchedAt == request.time
    && getAfter(submissionPath(sid)).data.ownerEmail == request.auth.token.email
    && getAfter(submissionPath(sid)).data.status in ['draft','rejected'];
  }
  // Staff may pre-fill an upload (before or after the artist claims it) until review is requested.
  function staffArtworkWrite(sid) {
   return staff() && existsAfter(submissionPath(sid))
    && getAfter(submissionPath(sid)).data.touchedAt == request.time
    && getAfter(submissionPath(sid)).data.status in ['invited','draft','rejected'];
  }
  match /virtualSubmissions/{sid} {
   allow get: if staff()
    || (resource.data.ownerEmail == '' && submissionLive(resource.data))
    || (submissionOwner(resource.data) && submissionLive(resource.data));
   allow list: if staff();
   allow create: if validSubmission(request.resource.data,sid) && (
    (staff() && request.resource.data.status == 'invited' && request.resource.data.ownerEmail == ''
     && request.resource.data.reviewNote == '' && request.resource.data.approvedGalleryId == ''
     && exists(/databases/$(database)/documents/exhibitions/$(request.resource.data.exhibitionId)))
    || (googleUser() && request.resource.data.status == 'draft'
     && request.resource.data.ownerEmail == request.auth.token.email
     && request.resource.data.invitedEmail == '' && request.resource.data.reviewNote == ''
     && request.resource.data.approvedGalleryId == '' && request.resource.data.targetGalleryId != ''
     && exists(/databases/$(database)/documents/virtualGalleries/$(request.resource.data.targetGalleryId))
     && boundArtist(get(/databases/$(database)/documents/virtualGalleries/$(request.resource.data.targetGalleryId)).data)
     && request.resource.data.exhibitionId == virtualParent(get(/databases/$(database)/documents/virtualGalleries/$(request.resource.data.targetGalleryId)).data,request.resource.data.targetGalleryId)));
   allow update: if validSubmission(request.resource.data,sid) && (
    (staff() && changedOnly(['status','reviewNote','approvedGalleryId','settings','touchedAt'])
     && (request.resource.data.settings == resource.data.settings || resource.data.status != 'submitted')
     && (request.resource.data.status == resource.data.status
      || (resource.data.status == 'submitted' && request.resource.data.status == 'rejected')))
    || (googleUser() && submissionLive(resource.data) && resource.data.ownerEmail == ''
     && resource.data.status == 'invited' && changedOnly(['ownerEmail','status','touchedAt'])
     && request.resource.data.ownerEmail == request.auth.token.email && request.resource.data.status == 'draft'
     && (resource.data.invitedEmail == '' || resource.data.invitedEmail == request.auth.token.email.lower()))
    || (submissionOwner(resource.data) && submissionLive(resource.data)
     && changedOnly(['settings','status','touchedAt']) && artistTransition(resource.data,request.resource.data)));
   allow delete: if staff();
   match /artworks/{artid} {
    allow read: if staff() || (submissionOwner(get(submissionPath(sid)).data) && submissionLive(get(submissionPath(sid)).data));
    allow create, update: if virtualId(artid) && (artistArtworkWrite(sid) || staffArtworkWrite(sid))
     && validArtworkFields(request.resource.data)
     && validSubmissionImage(request.resource.data.image,sid,artid,getAfter(submissionPath(sid)).data.targetGalleryId)
     && (!('model' in request.resource.data)
      || validModel(request.resource.data.model,'virtualSubmissions/'+sid+'/'+artid+'/')
      || (getAfter(submissionPath(sid)).data.targetGalleryId != ''
       && validModel(request.resource.data.model,'virtualGalleries/'+getAfter(submissionPath(sid)).data.targetGalleryId+'/'+artid+'/')));
    allow delete: if staff() || artistArtworkWrite(sid);
   }
  }
  match /staffEmails/{email} {
   allow get: if request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email == email;
   allow list, create, update, delete: if false;
  }
  match /staff/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, create, update, delete: if false;
  }
  match /exhibitions/{id} {
   allow read: if resource.data.published == true || staff();
   allow create, update: if staff() && valid(request.resource.data,id);
   allow delete: if staff();
  }
  match /homeHighlights/{id} {
   allow read: if resource.data.published == true || staff();
   allow create, update: if staff() && validHighlight(request.resource.data,id);
   allow delete: if staff();
  }
  // products/{id}: private staff inventory; no publishing field or public reads.
  function validProductImage(image,id) {
   // Required field access and matches() reject absent fields and non-string values.
   return image.keys().hasOnly(['url','path','alt']) && image.url == ''
    && image.path.matches('^products/'+id+'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}[.](jpeg|png|webp)$')
    && image.alt.matches('^[\\s\\S]{0,1000}$');
  }
  function productImages0(images,id,count) { return (count<=0 ? true : (validProductImage(images[0],id) && (count<=1 ? true : (validProductImage(images[1],id) && (count<=2 ? true : (validProductImage(images[2],id) && (count<=3 ? true : (validProductImage(images[3],id) && productImages4(images,id,count))))))))); }
  function productImages4(images,id,count) { return (count<=4 ? true : (validProductImage(images[4],id) && (count<=5 ? true : (validProductImage(images[5],id) && (count<=6 ? true : (validProductImage(images[6],id) && (count<=7 ? true : (validProductImage(images[7],id) && productImages8(images,id,count))))))))); }
  function productImages8(images,id,count) { return (count<=8 ? true : (validProductImage(images[8],id) && (count<=9 ? true : (validProductImage(images[9],id) && (count<=10 ? true : (validProductImage(images[10],id) && (count<=11 ? true : (validProductImage(images[11],id) && true)))))))); }
  function validProduct(data,id) {
   return id.matches('^[A-Za-z0-9_-]{1,100}$')
    && data.keys().hasAll(['name','summary','story','details','packaging','priceLabel','checkoutUrl','colors','specs','images','order','updatedAt'])
    && data.keys().hasOnly(['name','summary','story','details','packaging','priceLabel','checkoutUrl','colors','specs','images','order','updatedAt'])
    && data.name is string && data.name.size()>0 && data.name.size()<=200
    && data.summary is string && data.summary.size()<=600
    && data.story is string && data.story.size()<=5000
    && data.details is string && data.details.size()<=5000
    && data.packaging is string && data.packaging.size()<=5000
    && data.priceLabel is string && data.priceLabel.size()<=100
    && data.checkoutUrl is string && data.checkoutUrl.size()<=2000
    && (data.checkoutUrl == '' || data.checkoutUrl.matches('^https://([A-Za-z0-9][A-Za-z0-9.-]*|\\[[0-9a-fA-F:]+\\])(:[0-9]{1,5})?([/?#][^\\s]*)?$'))
    && data.colors is string && data.colors.size()<=1000
    && data.specs is string && data.specs.size()<=5000
    && data.updatedAt is string && data.updatedAt.size()<=50
    && data.order is int && data.order>=0 && data.order<=1000000
    && data.images is list && data.images.size()<=12
    && productImages0(data.images,id,data.images.size());
  }
  match /products/{id} {
   allow read, delete: if staff();
   allow create, update: if staff() && validProduct(request.resource.data,id);
  }
  match /{document=**} { allow read, write: if false; }
 }
}
