// Prototype model: exhibitions contain public editorial content when published=true.
// staff/{uid}: email + active, readable only by that user, managed outside client apps.
// All exhibition writes require verified Google sign-in plus a matching active staff record.
// staffEmails/{email}: email + active, managed by trusted project administrators.
// Image paths are scoped to the exhibition; uploads are handled by the R2 Worker.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function staff() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com'
    && exists(/databases/$(database)/documents/staffEmails/$(request.auth.token.email))
    && get(/databases/$(database)/documents/staffEmails/$(request.auth.token.email)).data.active == true
    && get(/databases/$(database)/documents/staffEmails/$(request.auth.token.email)).data.email == request.auth.token.email;
  }
  function validImage(image,id) {
   return image is map && image.keys().hasAll(['url','path','alt'])
    && image.keys().hasOnly(['url','path','alt','caption'])
    && image.url == '' && image.path is string && image.path.size()<=512
    && (image.path == '' || image.path.matches('^exhibitions/'+id+'/[^/]+$'))
    && image.alt is string && image.alt.size()<=1000
    && (!('caption' in image) || (image.caption is string && image.caption.size()<=2000));
  }
  function galleryItem(items,i,id) { return items.size()<=i || validImage(items[i],id); }
  function imagePath(items,i) { return items.size()<=i || (items[i] is string && items[i].size()<=512); }
  function validGallery(items,id) {
   return items is list && items.size()<=30
    && galleryItem(items,0,id)
    && galleryItem(items,1,id)
    && galleryItem(items,2,id)
    && galleryItem(items,3,id)
    && galleryItem(items,4,id)
    && galleryItem(items,5,id)
    && galleryItem(items,6,id)
    && galleryItem(items,7,id)
    && galleryItem(items,8,id)
    && galleryItem(items,9,id)
    && galleryItem(items,10,id)
    && galleryItem(items,11,id)
    && galleryItem(items,12,id)
    && galleryItem(items,13,id)
    && galleryItem(items,14,id)
    && galleryItem(items,15,id)
    && galleryItem(items,16,id)
    && galleryItem(items,17,id)
    && galleryItem(items,18,id)
    && galleryItem(items,19,id)
    && galleryItem(items,20,id)
    && galleryItem(items,21,id)
    && galleryItem(items,22,id)
    && galleryItem(items,23,id)
    && galleryItem(items,24,id)
    && galleryItem(items,25,id)
    && galleryItem(items,26,id)
    && galleryItem(items,27,id)
    && galleryItem(items,28,id)
    && galleryItem(items,29,id)
   ;
  }
  function validPaths(items) {
   return items is list && items.size()<=31
    && imagePath(items,0)
    && imagePath(items,1)
    && imagePath(items,2)
    && imagePath(items,3)
    && imagePath(items,4)
    && imagePath(items,5)
    && imagePath(items,6)
    && imagePath(items,7)
    && imagePath(items,8)
    && imagePath(items,9)
    && imagePath(items,10)
    && imagePath(items,11)
    && imagePath(items,12)
    && imagePath(items,13)
    && imagePath(items,14)
    && imagePath(items,15)
    && imagePath(items,16)
    && imagePath(items,17)
    && imagePath(items,18)
    && imagePath(items,19)
    && imagePath(items,20)
    && imagePath(items,21)
    && imagePath(items,22)
    && imagePath(items,23)
    && imagePath(items,24)
    && imagePath(items,25)
    && imagePath(items,26)
    && imagePath(items,27)
    && imagePath(items,28)
    && imagePath(items,29)
    && imagePath(items,30)
   ;
  }
  function valid(data,id) {
   return data.keys().hasAll(['title','slug','startDate','endDate','location','artists','summary','description','hours','admission','address','mapUrl','bookingUrl','cover','gallery','published','order','updatedAt','imagePaths'])
    && data.keys().hasOnly(['title','slug','startDate','endDate','location','artists','summary','description','hours','admission','address','mapUrl','bookingUrl','cover','gallery','published','order','updatedAt','imagePaths'])
    && data.title is string && data.title.size()>0 && data.title.size()<=200
    && data.slug is string && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && data.slug.size()<=200
    && data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && data.endDate is string && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.endDate >= data.startDate
    && data.location is string && data.location.size()>0 && data.location.size()<=1000
    && data.artists is string && data.artists.size()<=3000
    && data.summary is string && data.summary.size()<=600
    && data.description is string && data.description.size()<=30000
    && data.hours is string && data.hours.size()<=1000
    && data.admission is string && data.admission.size()<=1000
    && data.address is string && data.address.size()<=1000
    && data.mapUrl is string && data.mapUrl.size()<=2000
    && data.bookingUrl is string && data.bookingUrl.size()<=2000
    && validImage(data.cover,id) && validGallery(data.gallery,id)
    && data.published is bool && data.order is int && data.order>=0 && data.order<=1000000
    && validPaths(data.imagePaths)
    && data.updatedAt is string && data.updatedAt.size()<=50
    && (!data.published || (data.description.size()>0 && data.cover.path.matches('^exhibitions/'+id+'/[^/]+$')));
  }
  match /staffEmails/{email} {
   allow get: if request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email == email;
   allow list, create, update, delete: if false;
  }
  match /staff/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, create, update, delete: if false;
  }
  match /exhibitions/{id} {
   allow read: if resource.data.published == true || staff();
   allow create, update: if staff() && valid(request.resource.data,id);
   allow delete: if staff();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
