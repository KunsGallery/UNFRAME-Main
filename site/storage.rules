rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function staff() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com'
    && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
    && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.active == true
    && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.email == request.auth.token.email;
  }
  match /exhibitions/{id}/{file} {
   allow read: if staff() || (firestore.exists(/databases/(default)/documents/exhibitions/$(id)) && firestore.get(/databases/(default)/documents/exhibitions/$(id)).data.published == true && ('exhibitions/'+id+'/'+file) in firestore.get(/databases/(default)/documents/exhibitions/$(id)).data.imagePaths);
   allow create, update: if staff() && request.resource.size <= 10 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)');
   allow delete: if staff();
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
